rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理画面にログインできるメンバー（src/auth.ts の ADMIN_EMAILS と揃える）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'suzuki@growup-do.com',   // オーナー
          'iiken0126@gmail.com'     // コーダー
        ];
    }

    match /projects/{projectId} {
      allow get: if true;               // 共有ビュー：IDを知っていれば閲覧のみ可
      allow list: if isAdmin();         // プロジェクト一覧はメンバーのみ
      allow create, update, delete: if isAdmin();
    }
    // Webチャッピー プロトタイプの確認メモ・確認事項・やりとり（demo/src/memo, demo/src/issues）
    // クライアントがログインなしで書き込むため、プロトタイプの間は読み書きを開放する
    match /protoMemos/{memoId} {
      allow read, write: if true;
    }
  }
}
